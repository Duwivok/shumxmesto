# Production server. Do not commit filled values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=
RSVP_DB_PATH=/var/lib/shum/rsvp.sqlite
RSVP_OPEN=true
RSVP_GLOBAL_LIMIT_PER_MINUTE=300

# Server-only Telegram settings. The configured administrator can switch Geo
# globally with /hide and /show in the configured group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
