# Production server. Do not commit filled values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=
RSVP_DB_PATH=/var/lib/shum/rsvp.sqlite
RSVP_OPEN=true
RSVP_GLOBAL_LIMIT_PER_MINUTE=300

# Server-only Telegram settings. The organizer chat also controls Geo with
# /hide and /show; commands from every other chat are ignored.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORGANIZER_CHAT_ID=
